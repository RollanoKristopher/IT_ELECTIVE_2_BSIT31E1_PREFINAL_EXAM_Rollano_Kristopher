@model List<ExamMVC.Models.ExamQuestion>

<h1>Exam Answers</h1>

@foreach (var q in Model)
{
    <div>
        <h3>Q@(q.Number): @q.QuestionText</h3>
        <ul>
            @foreach (var c in q.Choices)
            {
                <li>@c.Key. @c.Value</li>
            }
        </ul>
        <p><strong>Answer:</strong> @q.CorrectLetter. @q.CorrectAnswerText</p>
    </div>
}